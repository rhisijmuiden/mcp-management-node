#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
  install -d -m 0700 /etc/mmn-agent /var/lib/mmn-agent
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable mmn-agent.service >/dev/null 2>&1 || true
    if [ -f /etc/mmn-agent/config.json ]; then
      systemctl restart mmn-agent.service >/dev/null 2>&1 || true
    fi
  fi
fi
exit 0
